SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_SCHEMA=job_agent
SUPABASE_RESUME_BUCKET=job-agent-resumes

# Local rewrite by default. Optional free Groq:
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=

# Auto-send to employer apply_email (default on).
RESEND_API_KEY=
APPLICATION_FROM_EMAIL=onboarding@resend.dev
# After verifying your domain in Resend, set e.g. noreply@allincenter.co.il
# Bare hostname only for catalog inboxes — example: allincenter.co.il
# (not https://..., not an email address). allincenter.co → auto-fixed to .co.il
APPLY_INBOUND_DOMAIN=
ENABLE_EMPLOYER_EMAIL=true
CANDIDATE_EMAIL=
MAX_APPLICATIONS_PER_RUN=40
# Cap successful auto-emails per user per Israel day (web-form via Next cron).
DAILY_AUTO_APPLY_QUOTA=20

SOCIAL_RSS_URLS=

MAX_JOB_AGE_DAYS=7
MIN_MATCH_SCORE=0.2

HOST=0.0.0.0
PORT=8000
