NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_SCHEMA=job_agent
NEXT_PUBLIC_SUPABASE_RESUME_BUCKET=job-agent-resumes

MIN_MATCH_SCORE=0.32
MAX_JOB_AGE_DAYS=7

# CV rewrite: local by default (no key). Optional free AI:
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Or Google AI Studio free tier:
GEMINI_API_KEY=
# OpenAI optional (often paid / rate-limited) — not required:
OPENAI_API_KEY=

RESEND_API_KEY=
APPLICATION_FROM_EMAIL=onboarding@resend.dev
# After verifying your domain in Resend, set e.g. noreply@allincenter.co.il
APPLICATION_NOTIFY_EMAIL=

# Auto web-form apply (Greenhouse / Lever / Ashby / Remotive / career HTML forms). Default on.
ENABLE_WEB_APPLY=true
MAX_WEB_APPLY_PER_RUN=20
MAX_EMAIL_FETCH_PER_RUN=15

# Successful auto-applies (email + web-form) per user per Israel calendar day (cron).
DAILY_AUTO_APPLY_QUOTA=20
# Each home-button / cron run targets this many successful auto-sends.
AUTO_APPLY_PER_RUN=20
# Match floor for auto-sendable (email/ATS) jobs only.
AUTO_APPLY_MIN_MATCH_SCORE=0.28
# Protects /api/cron/auto-apply (GitHub Actions + Vercel Cron). Set the same in repo secrets.
CRON_SECRET=

# Bare hostname only (no https://, no @). Example: allincenter.co.il
# Typo allincenter.co is auto-corrected to allincenter.co.il
APPLY_INBOUND_DOMAIN=
