NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_SCHEMA=job_agent
NEXT_PUBLIC_SUPABASE_RESUME_BUCKET=job-agent-resumes

MIN_MATCH_SCORE=0.3
MAX_JOB_AGE_DAYS=7

# CV rewrite: local by default (no key). Optional free AI:
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Or Google AI Studio free tier:
GEMINI_API_KEY=
# OpenAI optional (often paid / rate-limited) — not required:
OPENAI_API_KEY=

RESEND_API_KEY=
APPLICATION_FROM_EMAIL=onboarding@resend.dev
# After verifying your domain in Resend, set e.g. noreply@allincenter.co.il
APPLICATION_NOTIFY_EMAIL=

# Auto web-form apply (Greenhouse / Lever / Ashby / careers HTML forms). Default on.
ENABLE_WEB_APPLY=true
MAX_WEB_APPLY_PER_RUN=10

# Bare hostname only (no https://, no @). Example: allincenter.co.il
# Typo allincenter.co is auto-corrected to allincenter.co.il
APPLY_INBOUND_DOMAIN=
